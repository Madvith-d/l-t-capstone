# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg://academic:academic@postgres:5432/academic_assistant

# Ollama is the default local generator. The model tag must exist in your Ollama registry.
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
# Docker reaches the already-running host Ollama through this hostname.
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_BRIDGE_PORT=11435
LLM_TIMEOUT_SECONDS=120

# Optional Gemini provider settings.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Lightweight local ONNX embeddings (~384 dimensions, no PyTorch/API key).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.cache/fastembed

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.60
RETRIEVAL_MIN_TERM_COVERAGE=0.15
MULTI_STEP_MAX_SUBQUERIES=3
CHUNK_SIZE_TOKENS=850
CHUNK_OVERLAP_TOKENS=125
CONVERSATION_HISTORY_LIMIT=12
MAX_UPLOAD_MB=20
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=45000

CALENDAR_PROVIDER=mock
CALENDAR_API_KEY=

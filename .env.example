# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg://academic:academic@postgres:5432/academic_assistant

# Gemini generation. Create a key at https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=30

# Lightweight local ONNX embeddings (~384 dimensions, no PyTorch/API key).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.cache/fastembed

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
CHUNK_SIZE_TOKENS=850
CHUNK_OVERLAP_TOKENS=125
CONVERSATION_HISTORY_LIMIT=12
MAX_UPLOAD_MB=20

CALENDAR_PROVIDER=mock
CALENDAR_API_KEY=
